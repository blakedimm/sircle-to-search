<Window x:Class="CircleSearch.UI.Overlay.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:CircleSearch.UI.Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#40000000"
        Topmost="True"
        ShowInTaskbar="False"
        Focusable="True"
        Cursor="Cross"
        UseLayoutRounding="True">
    <Grid x:Name="RootGrid">
        <!-- Канвас отрисовки выделения -->
        <local:SelectionCanvas x:Name="TraceCanvas" />

        <!-- Плашка подсказки -->
        <Border HorizontalAlignment="Center" 
                VerticalAlignment="Top" 
                Margin="0,32,0,0"
                Background="#D91E1E2E" 
                CornerRadius="20" 
                Padding="20,9"
                BorderBrush="#33FFFFFF" 
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✨ Обведите объект или кликните по нему" 
                           Foreground="#E0E0E0" 
                           FontSize="13" 
                           FontWeight="SemiBold"/>
                <TextBlock Text=" • [Esc] Отмена" 
                           Foreground="#88FFFFFF" 
                           FontSize="13" 
                           Margin="8,0,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>