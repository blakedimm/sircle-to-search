<Window x:Class="CircleSearch.UI.Sidebar.LensSidebarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="880"
        Height="460"
        MinHeight="360"
        MinWidth="540"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Тонкий темный кастомный ScrollBar -->
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#313244" CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LoginBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#B4BEFE"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ActionPillBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2B3D"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121218" CornerRadius="16" BorderBrush="#262738" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="#181822" CornerRadius="15,15,0,0" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" MouseDown="Header_MouseDown">
                <Grid Margin="12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="22" Height="22" Stroke="#4285F4" StrokeThickness="1.5" RenderOptions.BitmapScalingMode="HighQuality">
                            <Ellipse.Fill>
                                <ImageBrush x:Name="AppHeaderIconBrush" Stretch="UniformToFill"/>
                            </Ellipse.Fill>
                        </Ellipse>

                        <TextBlock Text="Circle to Search" Foreground="#F5F5FA" FontWeight="SemiBold" FontSize="12.5" Margin="8,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ModeLabel" Text="Compact" Foreground="#6C7086" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BtnGoogleLogin" Click="BtnGoogleLogin_Click" Style="{StaticResource LoginBtn}" Content="🔑 Войти в Google" Margin="0,0,8,0"/>

                        <Border x:Name="AccountBadge" Background="#161E2E" BorderBrush="#263859" BorderThickness="1" CornerRadius="12" Padding="6,2" Margin="0,0,8,0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="UserAvatarEllipse" Width="18" Height="18" Margin="0,0,6,0">
                                    <Ellipse.Fill>
                                        <ImageBrush x:Name="UserAvatarBrush" Stretch="UniformToFill"/>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock x:Name="TxtAccountStatus" Text="Google подключен" Foreground="#89B4FA" FontSize="11" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Button ToolTip="Настройки" Click="BtnSettings_Click" Style="{StaticResource HeaderBtn}" Content="⚙" FontSize="13" Width="26" Height="26" Margin="0,0,4,0"/>
                        <Button ToolTip="Компактный вид" Click="BtnCompact_Click" Style="{StaticResource HeaderBtn}" Content="▫" FontSize="14" Width="26" Height="26" Margin="0,0,2,0"/>
                        <Button ToolTip="Боковая панель" Click="BtnSidebar_Click" Style="{StaticResource HeaderBtn}" Content="◧" FontSize="13" Width="26" Height="26" Margin="0,0,2,0"/>
                        <Button ToolTip="Развернуть" Click="BtnExpanded_Click" Style="{StaticResource HeaderBtn}" Content="🗖" FontSize="11" Width="26" Height="26" Margin="0,0,2,0"/>
                        <Button ToolTip="Открыть в браузере" Click="BtnOpenBrowser_Click" Style="{StaticResource HeaderBtn}" Content="↗" FontSize="13" Width="26" Height="26" Margin="0,0,6,0"/>
                        <Button ToolTip="Закрыть (Esc)" Click="BtnClose_Click" Style="{StaticResource HeaderBtn}" Content="✕" FontSize="11" Width="26" Height="26"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Основной контент -->
            <Border Grid.Row="1" CornerRadius="0,0,15,15" ClipToBounds="True">
                <Grid Background="#121218">
                    <wv2:WebView2 x:Name="Browser" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>

                    <!-- Нативный контейнер ответа ИИ с красивой типографикой -->
                    <Grid x:Name="AiResultContainer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Панель статуса -->
                        <Border Grid.Row="0" Background="#161622" BorderBrush="#14FFFFFF" BorderThickness="0,0,0,1" Padding="22,11">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="✦" Foreground="#89B4FA" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Обзор от ИИ" Foreground="#CBA6F7" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock Text="• Google Lens" Foreground="#6C7086" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>

                                <Button x:Name="BtnCopy" HorizontalAlignment="Right" Style="{StaticResource ActionPillBtn}" Click="BtnCopy_Click" Content="📋 Копировать" Padding="10,4" FontSize="11.5"/>
                            </Grid>
                        </Border>

                        <!-- Контент с приятными отступами и темным скроллом -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="32,22,24,22">
                            <TextBox x:Name="TxtAiContent" 
                                     TextWrapping="Wrap" 
                                     IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#E6EDF3" 
                                     FontSize="14.5" 
                                     FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif"
                                     SelectionBrush="#4285F4"
                                     Cursor="IBeam"/>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="AiFallbackCard" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Background="#181824" BorderBrush="#2D2E40" BorderThickness="1" CornerRadius="12" Padding="26,20" MaxWidth="500">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="🔍 Текстовый обзор ИИ не сформирован" Foreground="#CDD6F4" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                                <TextBlock Text="Google распознал объект, но не создал краткую выжимку. Вы можете открыть результаты поиска или перейти в браузер." 
                                           Foreground="#8A8F9E" FontSize="12.5" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Style="{StaticResource ActionPillBtn}" Click="BtnShowWebResults_Click" Content="Показать результаты" Margin="0,0,10,0"/>
                                    <Button Style="{StaticResource ActionPillBtn}" Click="BtnOpenBrowser_Click" Content="Открыть в браузере ↗"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid x:Name="LoadingOverlay" Background="#121218" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="3" BorderThickness="0" Foreground="#4285F4" Background="#1E1E2E"/>
                            <TextBlock x:Name="TxtStatus" Text="Поиск в Google..." Foreground="#A6ADC8" FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>