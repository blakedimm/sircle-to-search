<Window x:Class="CircleSearch.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        Width="460"
        Height="570"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Кнопки шапки -->
        <Style x:Key="HeaderBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка сохранить -->
        <Style x:Key="SaveBtn" TargetType="Button">
            <Setter Property="Background" Value="#4285F4"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5B9BFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Элементы внутри выпадающего списка -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}" Margin="2">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#313244"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#45475A"/>
                                <Setter Property="Foreground" Value="#89B4FA"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стрелочка и контейнер ComboBox -->
        <ControlTemplate x:Key="DarkComboBoxToggle" TargetType="ToggleButton">
            <Border x:Name="templateRoot" Background="#1E1E2E" BorderBrush="#313244" BorderThickness="1" CornerRadius="6">
                <Border Width="24" HorizontalAlignment="Right">
                    <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="#A6ADC8" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="templateRoot" Property="BorderBrush" Value="#4285F4"/>
                    <Setter TargetName="arrow" Property="Stroke" Value="#FFFFFF"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Полный стиль ComboBox без системного белого фона -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5F5FA"/>
            <Setter Property="Background" Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#313244"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Name="ToggleButton" Template="{StaticResource DarkComboBoxToggle}"
                                          Focusable="False" 
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" 
                                          ClickMode="Press"/>
                            <ContentPresenter Name="ContentSite" IsHitTestVisible="False" 
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                            <Popup Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Grid Name="DropDown" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border Background="#181825" BorderThickness="1" BorderBrush="#313244" CornerRadius="8" Margin="0,4,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
                                        </Border.Effect>
                                        <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#121218" CornerRadius="16" BorderBrush="#262738" BorderThickness="1" Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="42"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="56"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Border Grid.Row="0" Background="#181822" CornerRadius="15,15,0,0" BorderBrush="#1FFFFFFF" BorderThickness="0,0,0,1" MouseDown="Header_MouseDown">
                <Grid Margin="14,0">
                    <TextBlock Text="⚙ Настройки CircleSearch" Foreground="#F5F5FA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Button HorizontalAlignment="Right" Click="BtnClose_Click" Style="{StaticResource HeaderBtn}" Content="✕" FontSize="11" Width="26" Height="26"/>
                </Grid>
            </Border>

            <!-- Контент -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="18,14,18,6">
                <StackPanel>
                    <!-- Горячая клавиша -->
                    <TextBlock Text="Горячая клавиша поиска:" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="CmbModifiers" Grid.Column="0">
                            <ComboBoxItem Content="Ctrl + Shift"/>
                            <ComboBoxItem Content="Alt + Shift"/>
                            <ComboBoxItem Content="Ctrl + Alt"/>
                            <ComboBoxItem Content="Win + Shift"/>
                        </ComboBox>
                        <ComboBox x:Name="CmbKey" Grid.Column="2">
                            <ComboBoxItem Content="S"/>
                            <ComboBoxItem Content="X"/>
                            <ComboBoxItem Content="C"/>
                            <ComboBoxItem Content="Z"/>
                            <ComboBoxItem Content="D"/>
                            <ComboBoxItem Content="F"/>
                        </ComboBox>
                    </Grid>

                    <!-- Режим окна -->
                    <TextBlock Text="Вид окна результатов по умолчанию:" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CmbDefaultMode" Margin="0,0,0,16">
                        <ComboBoxItem Content="Compact (Компактный плавающий вид)"/>
                        <ComboBoxItem Content="Sidebar (Правая боковая панель)"/>
                        <ComboBoxItem Content="Expanded (Развернутое окно)"/>
                    </ComboBox>

                    <!-- Неоновый цвет рамки -->
                    <TextBlock Text="Цвет неоновой рамки выделения:" Foreground="#A6ADC8" FontSize="12" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,16">
                        <RadioButton x:Name="RbCyan" Content="Google Cyan" Foreground="#00D2FF" Margin="0,0,12,6" Checked="Color_Checked" Tag="#00D2FF"/>
                        <RadioButton x:Name="RbBlue" Content="Google Blue" Foreground="#89B4FA" Margin="0,0,12,6" Checked="Color_Checked" Tag="#4285F4"/>
                        <RadioButton x:Name="RbPurple" Content="Кибернеон" Foreground="#CBA6F7" Margin="0,0,12,6" Checked="Color_Checked" Tag="#CBA6F7"/>
                        <RadioButton x:Name="RbEmerald" Content="Изумрудный" Foreground="#A6E3A1" Checked="Color_Checked" Tag="#50FA7B"/>
                    </WrapPanel>

                    <!-- Затемнение экрана -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Затемнение экрана при поиске:" Foreground="#A6ADC8" FontSize="12"/>
                        <TextBlock x:Name="TxtDimVal" Text="40%" Foreground="#89B4FA" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SldDimming" Minimum="10" Maximum="80" Value="40" ValueChanged="SldDimming_ValueChanged" Margin="0,0,0,16"/>

                    <!-- Толщина контура -->
                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Толщина контура выделения:" Foreground="#A6ADC8" FontSize="12"/>
                        <TextBlock x:Name="TxtThickVal" Text="2.5 px" Foreground="#89B4FA" FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Slider x:Name="SldThickness" Minimum="1.0" Maximum="5.0" Value="2.5" SmallChange="0.5" ValueChanged="SldThickness_ValueChanged" Margin="0,0,0,18"/>

                    <!-- Опции поведения -->
                    <CheckBox x:Name="ChkAiOnly" Content="Показывать только ответ ИИ (скрыть шапку и лишнее)" Foreground="#ECEFF4" FontSize="12.5" Margin="0,0,0,12"/>
                    <CheckBox x:Name="ChkStartup" Content="Запускать вместе с Windows" Foreground="#ECEFF4" FontSize="12.5" Margin="0,0,0,10"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Футер -->
            <Border Grid.Row="2" Background="#161620" CornerRadius="0,0,15,15" BorderBrush="#1FFFFFFF" BorderThickness="0,1,0,0">
                <Grid Margin="18,0">
                    <Button HorizontalAlignment="Right" Click="BtnSave_Click" Style="{StaticResource SaveBtn}" Content="Сохранить"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>